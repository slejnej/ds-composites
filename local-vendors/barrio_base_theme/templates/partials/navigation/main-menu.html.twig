{% block main_menu %}

  {# Prepare the classes for the navbar #}
  {% set nav_classes = [
    'navbar',
    'navbar-expand-lg',
    'navbar-expand-lg',
    'px-0'
  ] %}

  {% if is_module_installed('remora_search') %}
    <div class="d-block d-lg-none">
      {{ drupal_block('remora_search_nav_block') }}
    </div>
  {% endif %}

  {% block nav %}

    {% block nav_theme %}
      <nav{{ attributes.addClass(nav_classes) }} data-bs-theme="dark">
    {% endblock %}

    <div class="navbar-content container-xxl g-xxl-0 justify-content-end">
      {% block button %}
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarNavDarkDropdown"
                aria-controls="navbarNavDarkDropdown" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
      {% endblock %}

      <div class="offcanvas offcanvas-end border-0" id="navbarNavDarkDropdown">

        {% block offcanvas_header %}
          <div class="offcanvas-header flex-row justify-content-between">
            <div class="d-flex justify-content-between align-items-center flex-grow-1">
              {% block gtranslate_mobile %}
                {% set gtranslate = drupal_block('gtranslate_block') %}
                {% if gtranslate['#plugin_id'] != 'broken' %}
                  <div id="gtranslate-mobile"></div>
                {% endif %}
              {% endblock %}
            </div>

            <button type="button" class="btn-close m-0 p-0" data-bs-dismiss="offcanvas" aria-label="Close"></button>
          </div>
        {% endblock %}

        {% block offcanvas_content %}
          <div class="offcanvas-content-wrapper d-flex flex-column justify-content-between h-100">

            {{ drupal_entity('block', 'barrio_base_theme_main_navigation') }}

            <div class="offcanvas-footer flex-row justify-content-between">
              {% block user_menu %}
                {% if drupal_menu('account') | render %}
                  <div class="user-menu d-lg-none">
                    {{ drupal_menu('account') }}
                  </div>
                {% endif %}
              {% endblock %}
            </div>
          </div>
        {% endblock %}

      </div>
    </div>
    </nav>
  {% endblock %}
{% endblock %}
