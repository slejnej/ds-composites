{% block footer %}

  {% block footer_primary %}
    <footer class="footer-primary container-fluid g-0 p-0">{% apply spaceless %}
        <div class="container-xxl g-0">
          {% set site_settings = site_setting_field('footer', 'field_footer_sections') %}

          {% for footer_setting in site_settings %}
            {% if footer_setting['#paragraph'] is defined and footer_setting['#paragraph'].bundle == 'footer_section' %}
              {{ footer_setting }}
            {% endif %}
          {% endfor %}
        </div>
      {% endapply %}</footer>
  {% endblock %}

  {% block footer_secondary %}
    <div class="footer-secondary">
      <div class="d-flex container-xxl mx-auto flex-column flex-sm-row justify-content-between align-items-center py-2">
        {% block footer_menu %}
          <div class="footer-menu">
            {{ drupal_menu('footer') }}
          </div>
        {% endblock %}

        {% block footer_branding %}
        <span></span>
      </div>
      {% endblock %}

    </div>
  {% endblock %}

{% endblock %}
