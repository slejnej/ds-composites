{% extends "field.html.twig" %}

{% block field_content %}
  {% for item in items %}
    <div{{ item.attributes.addClass(classes, 'field__item') }}>
      <a href="{{ item.content['#url'] }}" class="btn btn-primary w-100">{{ item.content['#title']|check_markup('title') }}</a>
    </div>
  {% endfor %}
{% endblock %}
