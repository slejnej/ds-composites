<?php

use Drupal\remora_core\Manager\LibraryManager;

/**
 *  Automatically registers all the templates in the templates/ directory
 *  @return array The theme containing the theme implementations (templates)
 */
function promo_pod_theme(): array
{
  return Drupal::service('remora_core.service.module_template')->generateThemesFromTemplates('promo_pod');
}

function promo_pod_page_attachments(array &$attachments): void
{
  LibraryManager::addAdminLibrary($attachments, 'promo_pod/admin_styles');
}