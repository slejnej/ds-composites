{% block search_section %}
  <div class="row g-0">
    {% block sidebar_first %}
      {% include '@drupal_search/partials/filter-sidebar.html.twig' %}
    {% endblock %}

    {% block page_content %}
      <div class="search-view-content order-2 order-md-2 col-12 col-lg-9 p-0 mb-3">
        <div class="container g-0">
          {% block search_content %}
            {{ page.content }}
          {% endblock %}
        </div>
      </div>
    {% endblock %}
  </div>
{% endblock %}
