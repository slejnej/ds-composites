{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    'd-none',
    'd-lg-block'
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    <div class="view-sort-display d-flex">
      {{ content.items_per_page }}
      {{ content.sort_bef_combine }}
    </div>
  {% endblock %}
</div>
