{% extends '@barrio_base_theme/partials/content/main-content.html.twig' %}

{% block main_wrapper %}
  {# only show div if there is at least 1 item being rendered #}
  {% set fields = content.field_media|merge_safe(content.field_body, content.field_main_pods, content.field_news_attachments) %}
  {% if fields['#items'] is not empty %}

    {% block content_main %}
      <section id="content-main" class="col g-0">
        <div class="content-main-container">
          <div id="content-main-fields" class="col">
            <div{{ content_attributes.addClass('node__content') }}>{% apply spaceless %}

                {{ block('media') }}

                {% block body %}
                  {% block content %}
                    {% if content.field_body['#items'] is not empty %}
                      <div class="body-wrapper">
                        {{ content.field_body }}
                      </div>
                    {% endif %}
                  {% endblock %}

                  {% block divider %}
                    {% if content.field_body['#items'] is not empty and content.field_news_attachments['#items'] is not empty %}
                      <hr class="content-divider">
                    {% endif %}
                  {% endblock %}

                  {% block tags %}
                  {% endblock %}

                  {% block downloads %}
                    {% if content.field_news_attachments['#items'] is not empty %}
                      <div class="node-downloads">
                        {% block downloads_label %}<div class="h3 pod-title">Downloads</div>{% endblock %}
                        {% block downloads_content %}
                          <div class="layout attachments">
                            {{ content.field_news_attachments }}
                          </div>
                        {% endblock %}
                      </div>
                    {% endif %}
                  {% endblock %}

                {% endblock body %}

                {{ block('main_content_pods') }}

              {% endapply %}</div>
          </div>
        </div>
      </section>
    {% endblock %}

  {% endif %}
{% endblock main_wrapper %}
