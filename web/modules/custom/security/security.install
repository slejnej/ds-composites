<?php

use Drupal\security\Form\HeadersConfigForm;

/**
 * Adds the default add HTTP headers to the configuration.
 */
function security_update_10110(): void
{
  Drupal::configFactory()
        ->getEditable(HeadersConfigForm::CONFIG_ID)
        ->set('add_http_headers', implode("\r\n", HeadersConfigForm::DEFAULT_HEADERS_TO_ADD))
        ->save();
}
